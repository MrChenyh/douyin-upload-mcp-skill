{
  "name": "social-auto-publish-skill",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "bootstrap:openclaw": "node scripts/bootstrap-openclaw.js --apply",
    "install:openclaw": "node scripts/install-openclaw-skill.js --apply",
    "export:skill": "node scripts/export-skill-package.js",
    "preflight": "node scripts/preflight.js",
    "help:ops": "node scripts/help.js",
    "agent:ready": "node scripts/agent-ready.js",
    "local:publish-console": "node local-publish-console/server.js",
    "mcp": "node src/mcp-server.js",
    "daemon": "node src/daemon/server.js",
    "publish:validate": "node scripts/validate-publish-task.js --task templates/publish-task.stability.json",
    "publish:stability": "node scripts/run-publish-task-stability.js --task templates/publish-task.stability.json --rounds 3",
    "sau:doctor": "node scripts/sau-publish-wrapper.js doctor",
    "stability:xiaohongshu-visible-publish": "node scripts/xiaohongshu-visible-publish-stability.js"
  },
  "keywords": [
    "social-publish",
    "douyin",
    "xiaohongshu",
    "kuaishou",
    "wechat-channels",
    "mcp"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "description": "Codex/OpenClaw skill for automatic publishing to Douyin, Xiaohongshu, Kuaishou, and WeChat Channels.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agent-browser": "^0.27.0",
    "puppeteer-core": "^24.39.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
